# copy to .dev.env (repo root, gitignored), pnpm dev loads it as KEY=VALUE
# all keys optional. with no .dev.env the server boots unconfigured and the
# portal shows the bootstrap setup wizard at localhost:3000

# pre-seed entra auth and skip the wizard (seedAuthFromEnv fills blank config at boot)
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# client secret for graph calls (people picker, client-cred flows). local runs have
# no key vault, the wizard shows the secret once and it goes here
#AZURE_CLIENT_SECRET=

# seeded into admin + portal-admin at boot, also arms the wizard oid lock
# (device-code signer must match, manual card requires sign-in first)
#BOOTSTRAP_ADMIN_OID=00000000-0000-0000-0000-000000000000

# seeds auth.serverUrl, mounts the mcp oauth router (blank locally is fine)
#CONDUIT_SERVER_URL=

# api port, 4000 default (3000 is the web dev server)
#PORT=4000

# override the first-party public client used by the wizard device-code flow
#CONDUIT_BOOTSTRAP_CLIENT_ID=
